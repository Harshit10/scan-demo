{
  "settingsInheritedFrom": "org-level-defaults/.whitesource@main",
  "scanSettings": {
    "baseBranches": ["main"],
    "configMode": "AUTO",
    "configExternalURL": ""
  },
  "checkRunSettings": {
    "vulnerableCheckRunConclusionLevel": "failure",
    "displayMode": "diff"
  },
  "issueSettings": {
    "minSeverityLevel": "MEDIUM",
    "issueType": "DEPENDENCY"
  },
  "remediateSettings": {
    "workflowRules": {
      "enabled": true
    }
  }
}
