# Mend (WhiteSource) Unified Agent config for this repo.
# Invoked from .vela.yml as:  java -jar wss-unified-agent.jar -c mend/wss-unified-agent.config
# Requires WS_APIKEY / WS_USERURL / WS_PRODUCTNAME / WS_PROJECTNAME as env vars
# (injected as Vela secrets — never committed here).

checkPolicies=true
forceCheckAllDependencies=true
forceUpdate=true
forceUpdate.failBuildOnPolicyViolation=true

# Gradle project support
gradle.resolveDependencies=true
gradle.aggregateModules=true
gradle.runPreStep=true
gradle.ignoreSourceCode=true

# Only scan what the build actually resolves
resolveAllDependencies=false
includes=**/*.jar

# Match the groups Renovate manages so alerts and PRs correlate 1:1
excludes=**/src/test/resources/**
